# GitHub App Authentication (recommended for multi-repo)
GITHUB_APP_ID=your_app_id_here
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_private_key_here\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Claude AI (OAuth auth token for Agent SDK)
CLAUDE_AUTH_TOKEN=your_claude_oauth_token_here

# BrowserStack (Required for Phase 1)
BROWSERSTACK_USERNAME=your_browserstack_username_here
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key_here

# Percy (for visual regression, optional)
PERCY_TOKEN=your_percy_token_here

# MobSF (for security scanning, optional)
MOBSF_API_KEY=your_mobsf_api_key_here

# Database (for Phase 5 - Knowledge Base, optional)
DATABASE_URL=postgresql://user:password@localhost:5432/testbot_db

# App Signing (optional, for release builds)
ANDROID_KEYSTORE_PATH=/path/to/keystore.jks
IOS_PROVISIONING_PROFILE=/path/to/provisioning_profile.mobileprovision

# Performance Thresholds (optional)
THRESHOLD_LAUNCH_COLD_MS=3000
THRESHOLD_LAUNCH_WARM_MS=1000
THRESHOLD_SCREEN_LOAD_MS=2000
THRESHOLD_FPS_MIN=55
THRESHOLD_MEMORY_MB=150
THRESHOLD_APP_SIZE_MB=100
THRESHOLD_APP_SIZE_INCREASE_MB=5
THRESHOLD_TEST_DURATION_SEC=300
THRESHOLD_MIN_PASS_RATE=90
THRESHOLD_COLOR_CONTRAST=4.5
THRESHOLD_TOUCH_TARGET_DP=48
THRESHOLD_CODE_COVERAGE=60
THRESHOLD_DELTA_COVERAGE=80

# Dashboard (uses same GitHub App credentials above)
# BOT_REPO=your-org/AutomatedTestingBot

# Debug
DEBUG=false
